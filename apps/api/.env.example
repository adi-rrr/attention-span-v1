PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/attention_span
# AUTH_JWKS_URL=

# Understand LLM (required — no static fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Sign-in (optional locally). Leave unset to run without login: the app's
# x-user-id header is trusted. Set it to require Supabase sign-in tokens.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# OWNER_EMAIL=you@example.com
# ALLOWED_EMAILS=friend@example.com
# SUPABASE_JWT_SECRET=   # only for older projects with a shared JWT secret
